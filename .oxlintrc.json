{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "vue"
    ],
    "categories": {
        "correctness": "error"
    },
    "options": {
        "typeAware": true
    },
    "ignorePatterns": [
        "docs/**",
        "example_repository/**",
        "build/**",
        "out/**",
        "release/**",
        ".nuxt/**",
        ".output/**"
    ]
}
